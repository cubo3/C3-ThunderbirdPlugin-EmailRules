{
  "manifest_version": 2,
  "name": "C3 Email Rules",
  "description": "Gestión de correo no deseado con clic derecho: bloquear/whitelist de remitente y dominio.",
  "version": "0.2.0",
  "author": "Cubo3 Ltda.",
  "homepage_url": "https://github.com/cubo3/C3-ThunderbirdPlugin-EmailRules",
  "applications": {
    "gecko": {
      "id": "email-rules@cubo3.cl",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "menus",
    "storage",
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate"
  ],
  "background": {
    "scripts": ["lib/rules.js", "background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
